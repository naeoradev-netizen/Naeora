<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Naéora — Cohérence cardiaque</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{width:100%;height:100%;background:#14123a;overflow:hidden;font-family:'Jost',sans-serif;}
  .stage{position:relative;width:100%;height:100vh;overflow:hidden;}
  .bg{position:absolute;top:0;left:0;width:100%;height:42%;object-fit:cover;object-position:top;}
  .overlay{position:absolute;top:0;left:0;width:100%;height:42%;background:linear-gradient(to bottom, transparent 55%, #14123a 100%);}

  .view{position:absolute;inset:0;z-index:3;display:none;flex-direction:column;}
  .view.active{display:flex;}

  /* ---------- Explication ---------- */
  #view-explain{padding-top:46%;padding-left:8vw;padding-right:8vw;padding-bottom:5vh;align-items:center;text-align:center;overflow-y:auto;}
  .ex-title{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1.6rem;color:#f7f2e9;margin-bottom:6px;flex-shrink:0;}
  .ex-divider{width:70px;height:1.5px;background:linear-gradient(to right, transparent, #d9b06f, transparent);margin:14px 0 18px;flex-shrink:0;}
  .ex-text{font-size:0.9rem;line-height:1.65;color:#e3ddf0;max-width:380px;margin-bottom:12px;}
  .ex-text b{color:#f3d9a8;font-weight:500;}
  .ex-tip{
    margin-top:6px;padding:13px 15px;border-radius:14px;
    background:rgba(217,176,111,0.08);border:1px solid rgba(217,176,111,0.3);
    font-size:0.82rem;line-height:1.5;color:#f3d9a8;max-width:380px;
  }
  .ex-btn{
    margin-top:3.5vh;padding:14px 38px;border-radius:30px;border:1px solid #d9b06f;
    background:rgba(217,176,111,0.1);color:#f7f2e9;font-size:0.82rem;letter-spacing:0.12em;
    text-transform:uppercase;cursor:pointer;font-family:inherit;flex-shrink:0;
  }

  /* ---------- Exercice actif ---------- */
  #view-active{padding-top:46%;padding-left:8vw;padding-right:8vw;align-items:center;justify-content:flex-start;text-align:center;position:relative;height:100%;}
  .help-icon{
    position:absolute;top:6vh;right:7vw;width:30px;height:30px;border-radius:50%;
    border:1px solid rgba(217,176,111,0.4);display:flex;align-items:center;justify-content:center;
    color:#d9b06f;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:0.95rem;cursor:pointer;
    background:rgba(255,255,255,0.04);z-index:4;
  }
  .end-icon{
    position:absolute;top:6vh;left:7vw;width:30px;height:30px;border-radius:50%;
    border:1px solid rgba(217,176,111,0.3);display:flex;align-items:center;justify-content:center;
    color:#a89fc4;font-size:0.9rem;cursor:pointer;
    background:rgba(255,255,255,0.04);z-index:4;
  }

  .halo-wrap{
    margin-top:9vh;position:relative;width:200px;height:200px;
    display:flex;align-items:center;justify-content:center;
  }
  .halo{
    position:absolute;border-radius:50%;
    background:radial-gradient(circle, rgba(247,242,233,0.5) 0%, rgba(217,176,111,0.32) 45%, rgba(217,176,111,0.08) 75%, transparent 100%);
    width:100px;height:100px;
    transform:scale(1);
    transition:transform 5s ease-in-out, opacity 5s ease-in-out;
  }
  .halo.outer{
    background:radial-gradient(circle, rgba(217,176,111,0.18) 0%, transparent 70%);
    width:160px;height:160px;
  }
  .halo.expand{transform:scale(1.6);}

  .breath-word{
    margin-top:5vh;
    font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;
    font-size:1.4rem;color:#cfc9e6;
    opacity:0;transition:opacity 2.4s ease;
    text-shadow:0 2px 10px rgba(0,0,0,0.35);
  }
  .breath-word.show{opacity:1;}

  /* ---------- Terminé ---------- */
  #view-done{align-items:center;justify-content:center;padding:8vw;text-align:center;}
  .done-msg{
    font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1.4rem;color:#f7f2e9;
    margin-bottom:2vh;max-width:380px;opacity:0;transition:opacity 2.2s ease, transform 2.2s ease;transform:translateY(10px);
  }
  .done-sub{
    font-family:'Cormorant Garamond',serif;font-style:italic;font-size:0.95rem;color:#cfc9e6;
    max-width:320px;line-height:1.6;opacity:0;transition:opacity 2.2s ease;transition-delay:0.6s;
  }
  #view-done.show-content .done-msg{opacity:1;transform:translateY(0);}
  #view-done.show-content .done-sub{opacity:1;}

  .testbar{position:absolute;top:8px;left:8px;z-index:50;display:flex;gap:4px;}
  .testbar button{font-size:0.6rem;padding:4px 7px;border-radius:5px;border:1px solid rgba(217,176,111,0.4);background:rgba(0,0,0,0.5);color:#d9b06f;cursor:pointer;}

  #view-done.show-content .return-home-fade{opacity:1 !important;}
</style>
</head>
<body>
  <div class="stage">
    <img class="bg" src="coherence.webp" alt="">
    <div class="overlay"></div>

    <div class="testbar">
      <button onclick="showView('explain')">Explication</button>
      <button onclick="startExercise()">Exercice</button>
    </div>

    <!-- VUE 1 : EXPLICATION -->
    <div class="view" id="view-explain">
      <div class="ex-title">Cohérence cardiaque</div>
      <div class="ex-divider"></div>
      <div class="ex-text">Ta respiration et ton système nerveux sont étroitement liés. En la ralentissant volontairement, tu envoies un <b>signal d'apaisement direct</b> à ton corps — ce n'est pas que mental, c'est physiologique.</div>
      <div class="ex-text">Laisse simplement ton souffle suivre le mouvement du halo : il s'agrandit, tu inspires. Il se resserre, tu expires. Pas besoin de compter, ni de forcer.</div>
      <div class="ex-tip">💡 Installe-toi confortablement, et laisse tes épaules se détendre avant de commencer.</div>
      <button class="ex-btn" onclick="startExercise()">J'ai compris</button>
    </div>

    <!-- VUE 2 : EXERCICE ACTIF -->
    <div class="view" id="view-active">
      <div class="help-icon" onclick="showView('explain')">?</div>
      <div class="end-icon" onclick="endExercise()">✕</div>

      <div class="halo-wrap">
        <div class="halo outer" id="haloOuter"></div>
        <div class="halo" id="halo"></div>
      </div>

      <div class="breath-word" id="breathWord"></div>
    </div>

    <!-- VUE 3 : TERMINÉ -->
    <div class="view" id="view-done">
      <div class="done-msg">Ton souffle s'est apaisé.</div>
      <div class="done-sub">Emmène cette sensation de calme avec toi, pour le reste de ta journée.</div>
      <button onclick="naeoraNav('accueil')" style="margin-top:5vh;padding:13px 30px;border-radius:30px;border:1px solid #d9b06f;background:rgba(217,176,111,0.12);color:#f7f2e9;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:0.92rem;cursor:pointer;opacity:0;transition:opacity 2.2s ease;transition-delay:1.2s;" class="return-home-fade">Retour à l'accueil</button>

    </div>
  </div>

  <script>
    let breathTimer = null;
    let cycleCount = 0;
    const MAX_CYCLES = 6; // ~1 minute (5s inspire + 5s expire) x 6 — ajustable
    const BREATH_DURATION = 5000;

    let audioCtx = null;
    function getAudioCtx(){
      if(!audioCtx){ audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      return audioCtx;
    }

    function playChime(freq){
      try{
        const ctx = getAudioCtx();
        const now = ctx.currentTime;

        // Fondamentale claire
        const osc = ctx.createOscillator();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now);

        // Harmonique haute pour l'effet cristallin
        const osc2 = ctx.createOscillator();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(freq * 2.0, now);

        // Scintillement très aigu, discret
        const osc3 = ctx.createOscillator();
        osc3.type = 'sine';
        osc3.frequency.setValueAtTime(freq * 4.0, now);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0, now);
        gain.gain.linearRampToValueAtTime(0.22, now + 0.05);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.8);

        const gain2 = ctx.createGain();
        gain2.gain.setValueAtTime(0, now);
        gain2.gain.linearRampToValueAtTime(0.11, now + 0.05);
        gain2.gain.exponentialRampToValueAtTime(0.0001, now + 2.2);

        const gain3 = ctx.createGain();
        gain3.gain.setValueAtTime(0, now);
        gain3.gain.linearRampToValueAtTime(0.045, now + 0.03);
        gain3.gain.exponentialRampToValueAtTime(0.0001, now + 1.2);

        osc.connect(gain);
        osc2.connect(gain2);
        osc3.connect(gain3);
        gain.connect(ctx.destination);
        gain2.connect(ctx.destination);
        gain3.connect(ctx.destination);

        osc.start(now);
        osc2.start(now);
        osc3.start(now);
        osc.stop(now + 2.9);
        osc2.stop(now + 2.3);
        osc3.stop(now + 1.3);
      } catch(e){ /* audio non disponible, on ignore silencieusement */ }
    }

    function showView(name){
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.getElementById('view-' + name).classList.add('active');
    }

    function breathCycle(){
      const halo = document.getElementById('halo');
      const haloOuter = document.getElementById('haloOuter');
      const word = document.getElementById('breathWord');

      // Inspire
      word.classList.remove('show');
      setTimeout(() => {
        word.textContent = 'Inspire…';
        word.classList.add('show');
        halo.classList.add('expand');
        haloOuter.classList.add('expand');
        playChime(880.00); // La5, note claire et cristalline pour l'inspiration
      }, 600);

      breathTimer = setTimeout(() => {
        // Expire
        word.classList.remove('show');
        setTimeout(() => {
          word.textContent = 'Expire…';
          word.classList.add('show');
          halo.classList.remove('expand');
          haloOuter.classList.remove('expand');
          playChime(698.46); // Fa5, légèrement plus grave mais toujours cristallin
        }, 600);

        breathTimer = setTimeout(() => {
          cycleCount++;
          if(cycleCount >= MAX_CYCLES){
            finishExercise();
          } else {
            breathCycle();
          }
        }, BREATH_DURATION);
      }, BREATH_DURATION);
    }

    function startExercise(){
      cycleCount = 0;
      showView('active');
      document.getElementById('halo').classList.remove('expand');
      document.getElementById('haloOuter').classList.remove('expand');
      document.getElementById('breathWord').classList.remove('show');
      clearTimeout(breathTimer);
      setTimeout(() => breathCycle(), 400);
    }

    function endExercise(){
      clearTimeout(breathTimer);
      finishExercise();
    }

    function finishExercise(){
      clearTimeout(breathTimer);
      showView('done');
      const doneView = document.getElementById('view-done');
      doneView.classList.remove('show-content');
      setTimeout(() => doneView.classList.add('show-content'), 50);
    }

    showView('explain');
  </script>
<script>function naeoraNav(route){ window.parent.postMessage({naeoraNav:route}, "*"); }</script></body>
</html>
